@if (Items.Count == 0)
{
    <p class="muted">ยังไม่มีรายการ</p>
}
else
{
    <ul class="ledger">
        @foreach (var i in Items)
        {
            var t = i.Transaction;
            <li class="tx">
                <span class="tx-icon" style="--tint:@i.CategoryColor">@i.CategoryIcon</span>
                <div class="tx-body">
                    <div class="tx-line">
                        <strong class="tx-title">@(string.IsNullOrWhiteSpace(t.Note) ? i.CategoryName : t.Note)</strong>
                        <span class="leader"></span>
                        <span class="tx-amount @(t.Type == TransactionType.Income ? "income" : "")">@(t.Type == TransactionType.Income ? "+" : "−")@t.Amount.Baht()</span>
                    </div>
                    <small class="muted">@i.CategoryName, @t.Date.ToString("d MMM yyyy", Formatting.Thai)</small>
                    @if (ShowActions)
                    {
                        <div class="tx-actions">
                            @if (confirmDeleteId == t.Id)
                            {
                                <button class="btn btn-danger btn-sm" @onclick="() => Delete(t.Id)">ลบรายการนี้</button>
                                <button class="btn btn-quiet btn-sm" @onclick="() => confirmDeleteId = null">ไม่ลบ</button>
                            }
                            else
                            {
                                <button class="btn btn-quiet btn-sm" @onclick="() => OnEdit.InvokeAsync(t.Id)">แก้ไข</button>
                                <button class="btn btn-quiet btn-sm" @onclick="() => confirmDeleteId = t.Id">ลบ</button>
                            }
                        </div>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    private int? confirmDeleteId;

    [Parameter, EditorRequired] public IReadOnlyList<TransactionItem> Items { get; set; } = [];
    [Parameter] public bool ShowActions { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private async Task Delete(int id)
    {
        confirmDeleteId = null;
        await OnDelete.InvokeAsync(id);
    }
}
