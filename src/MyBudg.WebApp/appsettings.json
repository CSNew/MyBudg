{
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "Registration": {
    "Mode": "Closed"
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/mybudg.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
